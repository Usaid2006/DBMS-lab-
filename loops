---------------------------------------------------------PRARTICAL 7

create or replace procedure evennumber
as
a number;
begin
a := 0;
while a < 20 loop
dbms_output.put_line(a);
a := a+2;
end loop;
end;
/

 set serveroutput on;
---
create or replace procedure summation
as
a number:= 0;
i number := 1;
begin
while a <= 20 loop
a := a + i;
i := i + 1;

dbms_output.put_line(a);

end loop;
end;
/
