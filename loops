CREATE OR REPLACE PROCEDURE test
AS
   cs   NUMBER := 45;
   os   NUMBER := 50;
   dbms NUMBER := 75;
   m3   NUMBER := 95;
BEGIN
total := cs + os + dbms +m3;
DBMS_OUTPUT.PUT_LINE('total');
   IF cs >= 50 AND os >= 50 AND dbms >= 50 AND m3 >= 50 THEN
      DBMS_OUTPUT.PUT_LINE('PASS');
   ELSE
      DBMS_OUTPUT.PUT_LINE('FAIL');
   END IF;
END;

